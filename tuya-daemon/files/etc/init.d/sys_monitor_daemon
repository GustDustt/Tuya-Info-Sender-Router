USE_PROCD=1
START=95

start_service() {
    config_load 'sys_monitor_daemon'
    local enabled
    local device_id
    local product_id
    local secret

    config_get_bool enabled 'settings' 'enabled' '0'
    config_get device_id 'settings' 'device_id' ''
    config_get product_id 'settings' 'product_id' ''
    config_get secret 'settings' 'secret' ''

    [ "$enabled" -ne 1 ] && return

    procd_open_instance
    procd_set_param command /usr/bin/sys_monitor_daemon -d "$device_id" -p "$product_id" -s "$secret"
    procd_set_param respawn
    procd_close_instance
}
